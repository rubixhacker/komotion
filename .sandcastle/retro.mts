import { execFileSync } from "node:child_process";
import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { fetchIssuesByTitle, type HostCommand } from "./issue-triage-github.mjs";
import { REPO } from "./queue.mjs";
import { retroIssue } from "./retro-body.mjs";
import { readRetroEvidence, selectRetroEvidence, type RetroEvidence } from "./retro-evidence.mjs";
import {
  proposalFingerprint,
  readRetroState,
  retroStatePath,
  writeRetroState,
} from "./retro-state.mjs";

/**
 * The post-pass retro. The pass writes a completion record when it ends; this
 * consumer runs in a separate process, after that process has exited, and opens
 * one `needs-triage` issue from the evidence it left behind. It never edits a
 * prompt or a configuration file, and it carries no sender filter: a bot issue
 * with `needs-triage` is already picked up by the event-driven issue-triage lane.
 */
export interface RetroResult {
  readonly created: boolean;
  readonly url: string | null;
  readonly reason: string;
}

export interface RunRetroOptions {
  readonly root: string;
  readonly run: HostCommand;
  /** Injected by tests; the CLI reads the finished-session logs. */
  readonly evidence?: RetroEvidence;
}

export function runRetro(options: RunRetroOptions): RetroResult {
  const evidence = options.evidence ?? readRetroEvidence(options.root);
  if (evidence.passes.length === 0)
    return { created: false, url: null, reason: "no completed passes" };
  // An idle pass with nothing to learn from must not flood triage with empty
  // issues. Only a pass that repaired, reviewed, delivered or failed carries
  // evidence a person could act on.
  const hasEvidence =
    evidence.repairRounds.length > 0 ||
    evidence.reviewFindings.length > 0 ||
    evidence.deliveryOutcomes.length > 0 ||
    evidence.passes.some(
      (pass) => pass.delivered > 0 || pass.phase === "failed" || pass.error !== null,
    );
  if (!hasEvidence) return { created: false, url: null, reason: "no substantive evidence" };

  const statePath = retroStatePath(options.root);
  const fingerprint = proposalFingerprint(evidence);
  const previous = readRetroState(statePath);
  if (previous.fingerprint === fingerprint)
    return { created: false, url: previous.issueUrl, reason: "proposal unchanged" };

  const issue = retroIssue(evidence);
  const lastPassId = evidence.passes.at(-1)?.passId ?? null;
  // The state file can be lost or carry a fingerprint from an older algorithm.
  // An issue with the same title is the stronger guarantee: the retro never
  // files another triage ticket for a proposal it already reported, even when
  // that issue was closed by a delivery. A new wording of the same proposal
  // still gets one issue; after that, the title keeps it from recurring.
  const knownIssues = fetchIssuesByTitle((args) => options.run("gh", args), REPO, 200);
  const duplicate = knownIssues.find((candidate) => candidate.title === issue.title);
  if (duplicate !== undefined) {
    const url = `https://github.com/${REPO}/issues/${duplicate.number}`;
    writeRetroState(statePath, { lastPassId, fingerprint, issueUrl: url });
    return { created: false, url, reason: "issue with the same proposal" };
  }

  const directory = mkdtempSync(join(tmpdir(), "sandcastle-retro-"));
  const bodyFile = join(directory, "issue.md");
  try {
    writeFileSync(bodyFile, issue.body);
    const url = options
      .run("gh", [
        "issue",
        "create",
        "--repo",
        REPO,
        "--title",
        issue.title,
        "--body-file",
        bodyFile,
        "--label",
        "needs-triage",
      ])
      .trim();
    writeRetroState(statePath, { lastPassId, fingerprint, issueUrl: url });
    return { created: true, url, reason: "issue created" };
  } finally {
    rmSync(directory, { recursive: true, force: true });
  }
}

const root = resolve(dirname(fileURLToPath(import.meta.url)), "..");

function hostCommand(program: string, args: readonly string[]): string {
  return execFileSync(program, [...args], {
    cwd: root,
    encoding: "utf8",
    maxBuffer: 8 * 1024 * 1024,
  }).trim();
}

/** Validate the issue contract with synthetic evidence, without touching GitHub. */
function checkWiring(): void {
  const evidence = selectRetroEvidence({
    status: null,
    completions: [
      {
        passId: "check",
        finishedAt: "2026-01-01T00:00:00.000Z",
        phase: "finished",
        delivered: 1,
        error: null,
      },
    ],
    phaseLines: [],
    ledger: {},
    findings: [],
    deliveredIssues: [1],
    reconciliationLines: [],
  });
  const issue = retroIssue(evidence);
  for (const fragment of [
    "> *This was generated by the factory retro.*",
    "## Evidence",
    "## Proposed improvement",
    "## Out of scope",
  ]) {
    if (!issue.body.includes(fragment))
      throw new Error(`retro body contract is missing ${fragment}`);
  }
  if (!issue.title.startsWith("[Factory retro] "))
    throw new Error("retro title contract is missing its prefix");
  console.log("retro wiring: OK");
}

if (process.argv[1] !== undefined && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  if (process.argv.includes("--check")) {
    checkWiring();
  } else {
    const result = runRetro({ root, run: hostCommand });
    console.log(`factory retro: ${result.reason}${result.url === null ? "" : ` ${result.url}`}`);
  }
}
