{
  "name": "komotion-sandcastle",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx main.mts",
    "drain": "tsx drain.mts",
    "check": "tsx main.mts --check",
    "status": "tsx status-cli.mts",
    "fleet": "tsx fleet.mts",
    "ci-repair": "tsx ci-repair.mts",
    "arm-merge": "tsx arm-merge.mts",
    "lanes:check": "tsx lane-wiring.mts --check",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "tsx --test *.test.mts && ([ ! -d macos ] || tsx --test macos/*.test.mts)",
    "dependabot": "tsx dependabot.mts",
    "dependabot:check": "tsx dependabot.mts --check",
    "triage": "tsx triage.mts",
    "triage:check": "tsx triage.mts --check"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.14.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
