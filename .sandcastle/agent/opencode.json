{
  "$schema": "https://opencode.ai/config.json",
  "websearch": false,
  "permission": {
    "websearch": "deny",
    "bash": {
      "*": "allow",
      "gh *": "deny",
      "*git push*": "deny",
      "*git stash*": "deny",
      "*git reset --hard*": "deny",
      "*git clean *": "deny",
      "*--no-verify*": "deny",
      "*pkill *": "deny",
      "*killall *": "deny"
    }
  }
}
