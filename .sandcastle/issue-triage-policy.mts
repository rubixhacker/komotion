import type { SubQDecision, SubQQuestion } from "./subq.mjs";
import { choiceOf, noulOf, probabilityOf } from "./subq.mjs";

/** The five terminal state roles from `docs/agents/triage-labels.md`. */
export const STATE_LABELS = [
  "ready-for-agent",
  "ready-for-human",
  "blocked",
  "wontfix",
  "needs-info",
] as const;
export type StateLabel = (typeof STATE_LABELS)[number];
/**
 * `unchanged` means an owner, PR or label conflict already owns the issue.
 * `unclear` is the indeterminate model result, before it falls back to a state role.
 */
export type IssueVerdict = StateLabel | "unchanged" | "unclear";
export type TriageClassification = StateLabel | "unclear";

export const TRIAGE_COMMENT_MARKER = "*This was generated by AI during triage.*";
export const FEEDBACK_MARKER = "/triage-feedback";

/**
 * Two SubQ questions, following the submission triage's pattern. The `ownerGate`
 * noul asks whether a person must decide or act; the `verdict` choice carries the
 * probability mass. A separate 0-5 confidence score is deliberately not asked:
 * SubQ spreads those answers close to uniform, which pins the mean near 2.5.
 */
export const issueTriageQuestions: Record<string, SubQQuestion> = {
  ownerGate: {
    type: "noul",
    instructions:
      "Does the next action on this issue require a human action or an owner product, scope, priority, copy, or legal decision that an agent harness cannot supply?",
    criteria: {
      true: "A named person must decide or act before the work can start or be accepted.",
      false: "Every remaining action can be performed and verified by an AFK agent.",
    },
  },
  verdict: {
    type: "choice",
    instructions: "Choose the triage state for this issue.",
    criteria: {
      "ready-for-agent": "Every remaining action is agent work, with no owner decision pending.",
      "ready-for-human": "A concrete human action or owner judgment is the next gate.",
      blocked: "The next action waits on an external dependency or another open issue.",
      wontfix: "The request is already implemented, duplicated elsewhere, or will not be actioned.",
      "needs-info": "The reporter must supply missing information before triage can continue.",
      unclear: "The issue text does not support a confident verdict.",
    },
  },
};

export function isStateLabel(value: string | undefined): value is StateLabel {
  return value !== undefined && (STATE_LABELS as readonly string[]).includes(value);
}

export function isTriageClassification(
  value: string | undefined,
): value is TriageClassification {
  return isStateLabel(value) || value === "unclear";
}

/** Probability bar per verdict. `wontfix` is highest: closing work down is costly. */
export type VerdictThresholds = Record<StateLabel, number>;

export interface IssueTriageThresholds {
  probability: VerdictThresholds;
  /** A noul at or above this value means a human gate is present. */
  ownerGate: number;
}

export function defaultThresholds(): IssueTriageThresholds {
  return {
    probability: {
      "ready-for-agent": 0.85,
      "ready-for-human": 0.8,
      blocked: 0.85,
      wontfix: 0.9,
      "needs-info": 0.85,
    },
    ownerGate: 0.5,
  };
}

export interface IssueTriageVerdict {
  classification: TriageClassification;
  /** Share of the probability mass SubQ assigned to the chosen classification. */
  probability: number;
  /** Probability that a human gate is present. */
  noul: number;
}

/** Reduce a SubQ response to the one verdict the policy reasons about. */
export function issueVerdictOf(decision: SubQDecision): IssueTriageVerdict {
  const classification = choiceOf(decision.answers.verdict);
  return {
    classification: isTriageClassification(classification) ? classification : "unclear",
    probability: probabilityOf(decision.answers.verdict, classification ?? "unclear"),
    noul: noulOf(decision.answers.ownerGate),
  };
}

/**
 * Take a verdict only when the chosen classification clears its probability bar
 * and the human-gate answer agrees. `ready-for-agent` and `ready-for-human` are
 * opposites on that gate; the other three states do not depend on it. Everything
 * else — `unclear`, a sub-threshold probability, or a gate disagreement — is
 * indeterminate and falls back to `ready-for-human`, the safe terminal state.
 */
export function decideIssueVerdict(
  verdict: IssueTriageVerdict,
  thresholds: IssueTriageThresholds,
): IssueVerdict {
  const { classification, probability, noul } = verdict;
  if (classification === "unclear") return "unclear";
  if (probability < thresholds.probability[classification]) return "unclear";
  if (classification === "ready-for-agent" || classification === "ready-for-human") {
    const needsHuman = classification === "ready-for-human";
    const gateAgrees = needsHuman
      ? noul >= thresholds.ownerGate
      : noul < thresholds.ownerGate;
    return gateAgrees ? classification : "unclear";
  }
  return classification;
}

/**
 * SubQ answers the same issue differently between calls. An actionable verdict
 * stands only when an independent second call reproduces it; any disagreement
 * is indeterminate rather than resolved in favour of either answer.
 */
export function decideIssueWithConfirmation(
  first: IssueTriageVerdict,
  confirmation: IssueTriageVerdict,
  thresholds: IssueTriageThresholds,
): IssueVerdict {
  const decision = decideIssueVerdict(first, thresholds);
  if (decision === "unclear") return "unclear";
  return decideIssueVerdict(confirmation, thresholds) === decision ? decision : "unclear";
}

/** An indeterminate verdict never leaves an issue in the triage queue. */
export function safeVerdict(verdict: StateLabel | "unclear"): StateLabel {
  return verdict === "unclear" ? "ready-for-human" : verdict;
}

export interface TriageIssue {
  number: number;
  title: string;
  body: string;
  labels: readonly string[];
}

export interface LocalIssueEvidence {
  openBlockers: readonly { number: number; title: string }[];
  /** An open PR, branch or worktree already claims this issue. */
  owner: string | undefined;
  /** A merged PR with a closing reference to this issue. */
  mergedCloser: number | undefined;
}

export interface LocalDecision {
  verdict: IssueVerdict;
  rule: string;
  reason: string;
}

export function stateLabelsOf(labels: readonly string[]): StateLabel[] {
  return labels.filter(isStateLabel);
}

/**
 * Decisions that need no model call. These cost nothing to check and cannot be
 * changed by a model: a conflicting label is the owner's to resolve, an owned
 * issue belongs to its worker, a merged closer already delivered the work, and
 * a live native blocking edge is the source of truth for `blocked`.
 */
export function localIssueDecision(
  issue: TriageIssue,
  evidence: LocalIssueEvidence,
): LocalDecision | undefined {
  const states = stateLabelsOf(issue.labels);
  if (states.length > 1) {
    return {
      verdict: "unchanged",
      rule: "label-conflict",
      reason: `Carries conflicting state labels: ${states.join(", ")}.`,
    };
  }
  if (evidence.owner) {
    return {
      verdict: "unchanged",
      rule: "owned",
      reason: `Already owned by ${evidence.owner}.`,
    };
  }
  if (evidence.mergedCloser !== undefined) {
    return {
      verdict: "wontfix",
      rule: "merged-closing-pr",
      reason: `Merged pull request #${evidence.mergedCloser} closes this issue.`,
    };
  }
  if (evidence.openBlockers.length > 0) {
    const listed = evidence.openBlockers.map((blocker) => `#${blocker.number}`).join(", ");
    return {
      verdict: "blocked",
      rule: "open-blockers",
      reason: `Waiting on open blocking issue${listed ? ` ${listed}` : ""}.`,
    };
  }
  return undefined;
}

export interface FingerprintIssue extends TriageIssue {
  comments: readonly { body: string }[];
}

/**
 * A stable view of an issue for the no-change window. State labels and this
 * lane's own comments are excluded: both change when a verdict is applied, so
 * including them would make a repeated pass re-triage its own output. An owner
 * comment or edit does change the fingerprint and earns a fresh verdict.
 */
export function issueContentFingerprint(issue: FingerprintIssue): string {
  // `needs-triage` is the queue label this lane removes; the rest of the state
  // roles are in STATE_LABELS. None of them is issue content.
  const labels = issue.labels
    .filter((label) => label !== "needs-triage" && !isStateLabel(label))
    .sort();
  const comments = issue.comments
    .filter((comment) => !comment.body.includes(TRIAGE_COMMENT_MARKER))
    .filter((comment) => !comment.body.trimStart().startsWith(FEEDBACK_MARKER))
    .map((comment) => comment.body);
  return JSON.stringify([issue.title, issue.body, labels, comments]);
}

/** Shorten free text before it enters a SubQ `state` payload. */
export function clip(text: string, max: number): string {
  const value = text.trim();
  return value.length <= max ? value : `${value.slice(0, max)}\n… (truncated)`;
}

export interface FeedbackDigestExcerpt {
  excerpt: string;
}

/** Render the issue and its deterministic evidence as a SubQ `state` block. */
export function issueTriageState(
  issue: TriageIssue,
  evidence: LocalIssueEvidence,
  feedbackExcerpt: string,
): string {
  const lines = [
    `Issue #${issue.number}: ${issue.title}`,
    `Labels: ${issue.labels.join(", ") || "(none)"}`,
    `Issue body:\n${clip(issue.body, 8_000)}`,
    `Open blockers: ${
      evidence.openBlockers.map((blocker) => `#${blocker.number} "${blocker.title}"`).join(", ") ||
      "(none)"
    }`,
    `Merged closing pull request: ${evidence.mergedCloser ?? "(none)"}`,
  ];
  if (feedbackExcerpt) lines.push(feedbackExcerpt);
  return lines.join("\n");
}

export interface TriageCommentInput {
  issue: TriageIssue;
  verdict: StateLabel;
  reason: string;
  evidence: readonly string[];
  indeterminate: boolean;
}

/**
 * The posted verdict. Every comment starts with the sweep's marker so the owner
 * can find it and so the feedback reader can locate the verdict being corrected.
 */
export function formatTriageComment(input: TriageCommentInput): string {
  const lines = [
    `> ${TRIAGE_COMMENT_MARKER}`,
    "",
    `Triage verdict: **${input.verdict}**`,
    "",
  ];
  if (input.verdict === "ready-for-agent") {
    lines.push(
      `Goal: ${input.issue.title}`,
      "Acceptance criteria: as stated in the issue body, plus merged-to-main, green CI, and a recorded run per platform the issue touches.",
      "Out of scope: anything the issue body does not name.",
      "",
    );
  }
  lines.push(`Reason: ${input.reason}`, "");
  if (input.indeterminate) {
    lines.push(
      "The decision model was not confident or its two calls disagreed. This was left for a human to decide rather than guessed at.",
      "",
    );
  }
  if (input.evidence.length > 0) {
    lines.push("Evidence:", ...input.evidence.map((line) => `- ${line}`), "");
  }
  lines.push(
    "If this verdict is wrong, reply with:",
    "",
    '`/triage-feedback wrong verdict=ready-for-human reason="a product decision is still open"`',
    "",
    "Replace the verdict with the correct state role and the reason with what the verdict missed. The next pass applies the correction and uses it to raise the bar for that verdict.",
  );
  return lines.join("\n");
}
