import type { RetroEvidence } from "./retro-evidence.mjs";

/**
 * The contract of a retro's triage issue. A retro proposes; it never changes a
 * prompt or a configuration file. The body carries the selected evidence, one
 * concrete improvement and an explicit out-of-scope line, so owner triage can
 * judge the proposal without opening the factory logs.
 */
export interface RetroIssue {
  readonly title: string;
  readonly body: string;
}

const RETRO_MARKER = "> *This was generated by the factory retro.*";
const OUT_OF_SCOPE =
  "This issue proposes no prompt or configuration edits; the owner decides whether any proposal becomes work.";
const SAMPLE_LIMIT = 3;

function short(text: string, max = 120): string {
  const oneLine = text.replace(/\s+/gu, " ").trim();
  return oneLine.length <= max ? oneLine : `${oneLine.slice(0, max - 1)}…`;
}

function mostCommon(values: readonly string[]): string {
  const counts = new Map<string, number>();
  for (const value of values) counts.set(value, (counts.get(value) ?? 0) + 1);
  return [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))[0]?.[0] ?? "unknown";
}

/** One concrete improvement, derived from the strongest repeated signal. */
export function proposeImprovement(evidence: RetroEvidence): string {
  if (evidence.repairRounds.length > 0) {
    // The repair detail names the check ("review", "Swift compile", ...), so
    // quoting it filed one issue per category. The body still lists the rounds;
    // the proposal and its title name the single improvement they all ask for.
    return "Add a pre-author check for repeated repair findings.";
  }
  const lastFinding = evidence.reviewFindings.at(-1);
  if (lastFinding !== undefined) {
    return `Add the recurring ${lastFinding.source} finding to the author's pre-delivery checklist so independent review stops repeating it.`;
  }
  const failures = evidence.deliveryOutcomes.filter((outcome) => outcome.kind !== "delivered");
  if (failures.length > 0) {
    return `Triage the repeated ${mostCommon(failures.map((outcome) => outcome.kind))} strike before the next pass tries the same ticket again.`;
  }
  return "Record the dominant no-delivery reason in a triage issue so the next pass starts with it.";
}

/** Render the evidence and its single proposal into a `needs-triage` issue. */
export function retroIssue(evidence: RetroEvidence): RetroIssue {
  const latest = evidence.passes.at(-1);
  const deliveries = latest?.delivered ?? evidence.status?.delivered ?? 0;
  const failedPasses = evidence.passes.filter((pass) => pass.phase === "failed").length;
  const findingTickets = new Set(evidence.reviewFindings.map((finding) => finding.issue));
  const proposal = proposeImprovement(evidence);

  const lines: string[] = [
    RETRO_MARKER,
    "",
    "## Evidence",
    "",
    `- Pass status: ${evidence.passes.length} completed pass(es), ${failedPasses} failed, ${deliveries} delivery(ies) in the latest pass.`,
    `- Review findings: ${evidence.reviewFindings.length} kept finding(s) across ${findingTickets.size} ticket(s).`,
    `- Repair rounds: ${evidence.repairRounds.length} repair round(s) recorded.`,
    `- Delivery outcomes: ${evidence.deliveryOutcomes.length} record(s).`,
    "",
  ];

  for (const pass of evidence.passes.slice(-SAMPLE_LIMIT)) {
    lines.push(`- Pass ${pass.passId}: ${pass.phase}, ${pass.delivered} delivery(ies)${pass.error === null ? "" : `, ${short(pass.error, 80)}`}.`);
  }
  for (const finding of evidence.reviewFindings.slice(0, SAMPLE_LIMIT)) {
    lines.push(`- Kept finding: #${finding.issue}, ${finding.source}.`);
  }
  for (const round of evidence.repairRounds.slice(-SAMPLE_LIMIT)) {
    lines.push(`- Repair round: ${short(round.detail, 160)}.`);
  }
  for (const outcome of evidence.deliveryOutcomes.slice(0, SAMPLE_LIMIT)) {
    lines.push(`- Delivery outcome: #${outcome.issue}, ${outcome.kind} — ${short(outcome.detail, 120)}.`);
  }

  lines.push(
    "",
    "## Proposed improvement",
    "",
    proposal,
    "",
    "## Out of scope",
    "",
    OUT_OF_SCOPE,
    "",
  );

  return { title: `[Factory retro] ${short(proposal, 72)}`, body: lines.join("\n") };
}
