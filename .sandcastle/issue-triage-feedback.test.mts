import assert from "node:assert/strict";
import { test } from "node:test";
import {
  type TriageComment,
  buildFeedbackDigest,
  calibrateThresholds,
  defaultCalibration,
  feedbackAcknowledgement,
  newCorrections,
  parseFeedback,
  readFeedbackLog,
} from "./issue-triage-feedback.mjs";
import { defaultThresholds } from "./issue-triage-policy.mjs";

const previous: TriageComment = {
  id: "c1",
  body: "> *This was generated by AI during triage.*\n\nTriage verdict: **ready-for-agent**",
  author: "sandcastle",
  createdAt: "2026-11-20T10:00:00Z",
};

const correction: TriageComment = {
  id: "c2",
  body: '/triage-feedback wrong verdict=ready-for-human reason="a product decision is still open"',
  author: "stewart",
  createdAt: "2026-11-20T11:00:00Z",
};

test("aFeedbackCommentIsParsedWithTheVerdictItCorrects", () => {
  const [parsed] = parseFeedback([previous, correction], 42);
  assert.equal(parsed?.issueNumber, 42);
  assert.equal(parsed?.commentId, "c2");
  assert.equal(parsed?.verdict, "ready-for-human");
  assert.equal(parsed?.previousVerdict, "ready-for-agent");
  assert.equal(parsed?.reason, "a product decision is still open");
});

test("previousVerdictSkipsMarkerCommentsWithoutAVerdictLine", () => {
  const acknowledgement: TriageComment = {
    id: "c3",
    body: feedbackAcknowledgement({
      issueNumber: 42,
      commentId: "c2",
      author: "stewart",
      createdAt: "2026-11-20T11:00:00Z",
      verdict: "ready-for-human",
      previousVerdict: "ready-for-agent",
      reason: "a product decision is still open",
    }),
    author: "sandcastle",
    createdAt: "2026-11-20T11:05:00Z",
  };
  const secondCorrection: TriageComment = {
    id: "c4",
    body: '/triage-feedback wrong verdict=blocked reason="still blocked"',
    author: "stewart",
    createdAt: "2026-11-20T12:00:00Z",
  };
  const [parsed] = parseFeedback([previous, acknowledgement, secondCorrection], 42);
  assert.equal(parsed?.issueNumber, 42);
  assert.equal(parsed?.commentId, "c4");
  assert.equal(parsed?.verdict, "blocked");
  assert.equal(parsed?.previousVerdict, "ready-for-agent");
});

test("aCommentThatOnlyMentionsTheMarkerInProseIsIgnored", () => {
  const prose: TriageComment = {
    ...correction,
    body: "I thought about /triage-feedback wrong verdict=blocked reason=maybe",
  };
  assert.deepEqual(parseFeedback([prose], 42), []);
});

test("anUnknownOrMissingVerdictIsIgnored", () => {
  const invalid: TriageComment = { ...correction, body: "/triage-feedback wrong verdict=nonsense reason=x" };
  const noReason: TriageComment = { ...correction, body: "/triage-feedback wrong verdict=blocked" };
  assert.deepEqual(parseFeedback([invalid, noReason], 42), []);
});

test("alreadyRecordedCorrectionsAreNotAppliedTwice", () => {
  const [parsed] = parseFeedback([previous, correction], 42);
  assert.ok(parsed);
  assert.equal(newCorrections([parsed], new Set(["c2"])).length, 0);
  assert.equal(newCorrections([parsed], new Set()).length, 1);
});

test("theDigestCountsTheVerdictsThatWereWrong", () => {
  const [parsed] = parseFeedback([previous, correction], 42);
  assert.ok(parsed);
  const digest = buildFeedbackDigest([parsed]);
  assert.equal(digest.counts["ready-for-agent"], 1);
  assert.match(digest.excerpt, /#42: ready-for-agent -> ready-for-human/);
});

test("aRepeatedlyCorrectedVerdictGetsAHigherBar", () => {
  const corrections = Array.from({ length: 4 }, (_, index) => ({
    issueNumber: index,
    commentId: `c${index}`,
    author: "stewart",
    createdAt: `2026-11-2${index}T00:00:00Z`,
    verdict: "ready-for-human" as const,
    previousVerdict: "ready-for-agent" as const,
    reason: "still a product decision",
  }));
  const base = defaultThresholds();
  const calibrated = calibrateThresholds(base, buildFeedbackDigest(corrections));
  assert.equal(calibrated.probability["ready-for-agent"], base.probability["ready-for-agent"] + 2 * defaultCalibration.step);
  assert.equal(calibrated.probability["ready-for-human"], base.probability["ready-for-human"]);
  assert.equal(calibrated.ownerGate, base.ownerGate);
});

test("aSingleCorrectionDoesNotMoveTheBar", () => {
  const [parsed] = parseFeedback([previous, correction], 42);
  assert.ok(parsed);
  const base = defaultThresholds();
  assert.deepEqual(calibrateThresholds(base, buildFeedbackDigest([parsed])), base);
});

test("aCorrectionNeverLowersAConfiguredHighBar", () => {
  const corrections = Array.from({ length: 10 }, (_, index) => ({
    issueNumber: index,
    commentId: `c${index}`,
    author: "stewart",
    createdAt: `2026-11-${String(index + 1).padStart(2, "0")}T00:00:00Z`,
    verdict: "ready-for-human" as const,
    previousVerdict: "wontfix" as const,
    reason: "not delivered",
  }));
  const base = defaultThresholds();
  base.probability.wontfix = 1;
  const calibrated = calibrateThresholds(base, buildFeedbackDigest(corrections));
  assert.equal(calibrated.probability.wontfix, 1);
});

test("theBarIsCappedBelowCertainty", () => {
  const corrections = Array.from({ length: 100 }, (_, index) => ({
    issueNumber: index,
    commentId: `c${index}`,
    author: "stewart",
    createdAt: `2026-11-${String(index + 1).padStart(2, "0")}T00:00:00Z`,
    verdict: "ready-for-human" as const,
    previousVerdict: "wontfix" as const,
    reason: "not delivered",
  }));
  const calibrated = calibrateThresholds(defaultThresholds(), buildFeedbackDigest(corrections));
  assert.ok(calibrated.probability.wontfix <= defaultCalibration.max);
});

test("theAcknowledgementNamesTheOldAndNewVerdict", () => {
  const [parsed] = parseFeedback([previous, correction], 42);
  assert.ok(parsed);
  assert.match(feedbackAcknowledgement(parsed), /ready-for-agent to \*\*ready-for-human\*\*/);
});

test("anAppendOnlyFeedbackLogSurvivesATruncatedLine", () => {
  const [parsed] = parseFeedback([previous, correction], 42);
  assert.ok(parsed);
  const text = `${JSON.stringify(parsed)}\n{"commentId":"broken"\n`;
  const records = readFeedbackLog(text);
  assert.equal(records.length, 1);
  assert.equal(records[0]?.commentId, "c2");
  assert.deepEqual(readFeedbackLog(""), []);
});
