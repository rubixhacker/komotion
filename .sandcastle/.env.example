# GitHub personal access token — the host uses it to read issues and open
# pull requests. The sandbox never sees it (seatbelt hides the host's gh
# login). Fine-grained token with Contents (read), Issues (read and write),
# and Pull requests (read and write) on rubixhacker/komotion.
GH_TOKEN=

# OpenAI-compatible endpoint that serves the factory's model.
VLLM_BASE_URL=http://192.168.1.3:18982/v1

# The agent model (provider/model).
SANDCASTLE_MODEL=vllm/Qwen3.8
