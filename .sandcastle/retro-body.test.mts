import { test } from "node:test";
import assert from "node:assert/strict";
import { proposeImprovement, retroIssue } from "./retro-body.mjs";
import { selectRetroEvidence, type RetroEvidence } from "./retro-evidence.mjs";
import type { TicketLedger } from "./ticket-ledger.mjs";

const AT = "2026-11-23T10:00:00.000Z";

function evidenceFor(overrides: {
  phaseLines?: unknown[];
  findings?: { issue: number; source: string }[];
  ledger?: TicketLedger;
} = {}): RetroEvidence {
  return selectRetroEvidence({
    status: null,
    completions: [{ passId: "p1", finishedAt: AT, phase: "finished", delivered: 2, error: null }],
    phaseLines: overrides.phaseLines ?? [],
    ledger: overrides.ledger ?? {},
    findings: overrides.findings ?? [],
    deliveredIssues: [42],
    reconciliationLines: [],
  });
}

test("the issue carries all four evidence categories and one proposal", () => {
  const issue = retroIssue(evidenceFor());
  assert.match(issue.title, /^\[Factory retro\] /u);
  assert.match(issue.body, /^> \*This was generated by the factory retro\.\*/u);
  for (const fragment of ["## Evidence", "## Proposed improvement", "## Out of scope"]) {
    assert.ok(issue.body.includes(fragment), `body is missing ${fragment}`);
  }
  assert.equal(issue.body.split("## Proposed improvement").length - 1, 1);
  for (const category of ["Pass status:", "Review findings:", "Repair rounds:", "Delivery outcomes:"]) {
    assert.ok(issue.body.includes(category), `body is missing ${category}`);
  }
  assert.ok(issue.body.length < 8 * 1024);
});

test("the body states that it never edits prompts or configuration", () => {
  const issue = retroIssue(evidenceFor());
  assert.match(
    issue.body,
    /This issue proposes no prompt or configuration edits; the owner decides whether any proposal becomes work\./u,
  );
  assert.ok(!issue.body.includes("git push"));
  assert.ok(!issue.body.includes("apply_patch"));
});

test("the proposal follows the strongest repeated signal", () => {
  assert.match(
    proposeImprovement(
      evidenceFor({
        phaseLines: [
          { at: AT, passId: "p1", phase: "authoring", ticket: 42, detail: "repair round 1/3" },
        ],
      }),
    ),
    /^Add a pre-author check for repeated repair findings\.$/u,
  );
  assert.match(
    proposeImprovement(evidenceFor({ findings: [{ issue: 42, source: "review" }] })),
    /the recurring review finding/u,
  );
  assert.match(
    proposeImprovement(
      evidenceFor({
        ledger: {
          "42": { strikes: [{ at: AT, kind: "review-failed", detail: "finding" }] },
        },
      }),
    ),
    /^Triage the repeated review-failed strike/u,
  );
  assert.match(
    proposeImprovement(evidenceFor()),
    /Record the dominant no-delivery reason/u,
  );
});

test("repair categories file one proposal, not one per check", () => {
  const round = (passId: string, source: string, ticket = 42) => ({
    at: AT,
    passId,
    phase: "authoring",
    ticket,
    detail: `repairing ${source} findings (round 2/3)`,
  });
  const review = retroIssue(
    evidenceFor({ phaseLines: [round("p1", "review"), round("p2", "review")] }),
  );
  const swiftCompile = retroIssue(
    evidenceFor({ phaseLines: [round("p3", "Swift compile"), round("p4", "Swift compile")] }),
  );
  assert.equal(review.title, swiftCompile.title);
  assert.equal(review.title, "[Factory retro] Add a pre-author check for repeated repair findings.");
  assert.equal(
    proposeImprovement(
      evidenceFor({ phaseLines: [round("p1", "review"), round("p2", "review")] }),
    ),
    proposeImprovement(
      evidenceFor({ phaseLines: [round("p3", "Swift compile"), round("p4", "Swift compile")] }),
    ),
  );
  assert.ok(swiftCompile.body.includes("repairing Swift compile findings (round 2/3)"));
  assert.ok(review.body.includes("repairing review findings (round 2/3)"));
});
